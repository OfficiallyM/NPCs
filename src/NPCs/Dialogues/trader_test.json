{
	"id": "trader_test",
	"entry": [ "root", "root_in_vehicle" ],
	"nodes": {
		"root": {
			"text": [
				"Well, look what the road dragged in. You buying or just wasting my time?",
				"Hey {playerName}, back again? What do you need?",
				"You look like you've had a rough drive. What are you after?"
			],
			"options": [
				{
					"text": "Show me what you've got. [Start a trade]",
					"action": "open_trade",
					"next": [ "@background" ]
				},
				{
					"text": "What's your best price?",
					"next": [ "haggle" ]
				},
				{
					"text": "Any chance of a freebie?",
					"conditions": [ "not:memory:freebie_tried" ],
					"action": "set_memory:freebie_tried=true",
					"next": [ "freebie_accepted", "freebie_rejected" ]
				},
				{
					"text": "Just passing through.",
					"next": [ "farewell" ]
				}
			]
		},
		"root_in_vehicle": {
			"text": [ "At least get out of your vehicle if you want to trade" ],
			"conditions": [ "player_in_vehicle" ],
			"priority": 1
		},
		"haggle": {
			"text": [ "My prices are fair. You won't find better out here." ],
			"next": [ "haggle_response" ]
		},
		"haggle_response": {
			"text": [ "So. You buying or not?" ],
			"options": [
				{
					"text": "Fine. Show me. [Start a trade]",
					"action": "open_trade",
					"next": [ "@background" ]
				},
				{
					"text": "Never mind.",
					"next": [ "farewell" ]
				}
			]
		},
		"freebie_accepted": {
			"text": [ "Sure, here's a silver." ],
			"next": null,
			"actions": [ "give_item:silver" ],
			"weight": 20
		},
		"freebie_rejected": {
			"text": [ "No chance." ],
			"next": null,
			"weight": 80
		},
		"farewell": {
			"text": [ "Suit yourself. Road's long." ],
			"next": null
		},
		"trade_cancelled": {
			"text": [ "Some other time, perhaps." ],
			"next": null
		},
		"trade_accepted": {
			"text": [ "Pleasure doing business with you." ],
			"next": null
		},
		"trade_rejected": {
			"text": [ "Do you take me for an idiot or something?" ],
			"next": [ "@background" ]
		},
		"trade_empty": {
			"text": [ "Well I ain't giving you anything for free." ],
			"next": [ "@background" ]
		}
	}
}